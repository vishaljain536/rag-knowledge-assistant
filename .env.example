# Never commit real keys. Users enter keys in the app or set these values locally.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
PINECONE_API_KEY=
PINECONE_INDEX=
DATABASE_URL=sqlite:///./data/app.db
VECTOR_STORE=faiss

# Private hosted deployments: set a long random value and enter it in the UI.
# Leave empty only for trusted local development.
APP_ACCESS_KEY=

# URL fetching is unsafe on public deployments until SSRF hardening is implemented.
ENABLE_URL_INGESTION=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=data
