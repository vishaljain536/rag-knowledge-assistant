# Admin sign-in at <frontend>/#admin. Username defaults to "admin".
# Generate a strong password with: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=
# Optional fixed token for scripts that read /logs and /logs/stream.
ADMIN_TOKEN=

# Optional: Google OAuth web client ID. Enables "Continue with Google" on the sign-in screen.
# Add the frontend origin under "Authorized JavaScript origins" in Google Cloud Console.
GOOGLE_CLIENT_ID=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_URL_INGESTION=false
URL_ALLOWED_HOSTS=
VITE_ENABLE_URL_INGESTION=false
VITE_API_URL=http://localhost:8000

# Optional server-approved resources.
AZURE_ALLOWED_ENDPOINTS=
HUGGINGFACE_ALLOWED_MODELS=
PINECONE_API_KEY=
PINECONE_INDEX=

# Optional server-managed keys. Only the admin may select them.
# Never use VITE_ variables for these values.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
