# Supply a JSON object mapping workspace slugs to independent random tokens.
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKSPACE_TOKENS='{}'
# Generate a separate token for /logs and /logs/stream when needed.
ADMIN_TOKEN=

# Required for the optional local or hosted demo admin login.
# Generate a strong value with: python -c "import secrets; print(secrets.token_urlsafe(24))"
DEMO_ADMIN_PASSWORD=
# Set true only for localhost demo login.
ENABLE_LOCAL_DEMO_LOGIN=false
# Set this exact HTTPS frontend origin only to enable hosted demo login.
HOSTED_DEMO_ORIGIN=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_URL_INGESTION=false
URL_ALLOWED_HOSTS=
VITE_ENABLE_URL_INGESTION=false
VITE_API_URL=http://localhost:8000

# Optional server-approved resources.
AZURE_ALLOWED_ENDPOINTS=
HUGGINGFACE_ALLOWED_MODELS=
PINECONE_API_KEY=
PINECONE_INDEX=
